# =============================================================
# EduNexus LMS — Production Environment Variables
# =============================================================
# Copy this file to .env.production.local on your server
# and fill in your real values before running docker-compose up.
# NEVER commit this file with real secrets.

# =============================================================
# SUPABASE (Required)
# =============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================
# APP
# =============================================================
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=EduNexus LMS
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise Learning Management System

# =============================================================
# JOBE CODE EXECUTION (auto-configured by docker-compose)
# =============================================================
# When using docker-compose.yml, this is set automatically.
# Only change this if you're running Jobe on a separate server.
JOBE_URL=http://jobe/jobe/index.php/restapi
JOBE_API_KEY=
JOBE_TIMEOUT=10000
JOBE_DEFAULT_TIME_LIMIT=5
JOBE_DEFAULT_MEMORY_LIMIT=256

# =============================================================
# CODE EXECUTION LIMITS
# =============================================================
CODE_MAX_SOURCE_SIZE=65536
CODE_MAX_INPUT_SIZE=32768
CODE_MAX_OUTPUT_SIZE=65536
