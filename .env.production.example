# ==============================================================================
# SENSILEARN LMS — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ==============================================================================
# Configure these variables in your Vercel Project Dashboard:
# Project -> Settings -> Environment Variables
# Target Environment: Production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://vdpokcnbslgzyufybxey.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. CANONICAL APP URL & BRANDING (Required)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://sensilearn.com
NEXT_PUBLIC_APP_NAME=SensiLearn LMS
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise Learning Management System
NEXT_PUBLIC_COMPANY_NAME=SensiLearn Learning Technologies
NEXT_PUBLIC_SUPPORT_EMAIL=support@sensilearn.com

# ------------------------------------------------------------------------------
# 3. RENDER COMPILER (Required)
# ------------------------------------------------------------------------------
JOBE_URL=https://<your-compiler-service>.onrender.com/jobe/index.php/restapi
JOBE_API_KEY=
JOBE_TIMEOUT=15000
JOBE_DEFAULT_TIME_LIMIT=5
JOBE_DEFAULT_MEMORY_LIMIT=256
CODE_MAX_SOURCE_SIZE=65536
CODE_MAX_INPUT_SIZE=32768
CODE_MAX_OUTPUT_SIZE=65536
SQL_EXECUTION_URL=/api/sql/run

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH / IDENTITY SERVICES (Recommended)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=658302087365-lurl6cagv36c4bm8ub4gs7b29930l846.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. OPTIONAL: LIVEKIT & SMTP
# ------------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sensilearn.com
