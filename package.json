{
  "name": "enterprise-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --turbo",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build --webpack",
    "start": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:compiler": "node --env-file=.env.local scripts/run-regression.js",
    "test:languages": "npx tsx --env-file=.env.local scripts/test-compilers.ts",
    "test:batches": "npx tsx --env-file=.env.local scripts/test-batch-visibility-system.ts",
    "test:email": "npx tsx --env-file=.env.local scripts/test-smtp.ts",
    "email:broadcast": "npx tsx --env-file=.env.local scripts/broadcast-hosting-announcement.ts",
    "test:all": "npm run typecheck && npm run test:compiler && npm run test:languages && npm run test:batches && npm run test:email",
    "test:templates": "node --env-file=.env.local scripts/test-email-notification-system.js",
    "test:responsive": "node scripts/test-responsive-design.js"
  },
  "allowScripts": {
    "unrs-resolver": true
  },
