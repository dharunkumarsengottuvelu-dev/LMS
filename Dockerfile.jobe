FROM trampgeek/jobeinabox:latest

# Install Python 3 database packages and native DB clients
RUN apt-get update && \
    apt-get install -y python3-pip python3-pymysql python3-psycopg2 default-mysql-client postgresql-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Note: Python3 is already installed in trampgeek/jobeinabox.
# We use apt packages (python3-pymysql, python3-psycopg2) to avoid pip breakages in system Python.
