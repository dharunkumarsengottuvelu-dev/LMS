# =============================================================
# EduNexus Enterprise LMS — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# =============================================================
# SUPABASE
# =============================================================
# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Your Supabase service role key (NEVER expose to browser — server only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================
# JOBE CODE EXECUTION SERVER
# =============================================================
# Dev: http://localhost/jobe/index.php/restapi
# Prod: https://jobe.yourdomain.com/jobe/index.php/restapi
JOBE_URL=http://localhost/jobe/index.php/restapi

# Optional API key if your Jobe server is configured to require X-API-KEY header
JOBE_API_KEY=

# Execution timeouts & limits
JOBE_TIMEOUT=10000
JOBE_DEFAULT_TIME_LIMIT=5
JOBE_DEFAULT_MEMORY_LIMIT=256
CODE_MAX_SOURCE_SIZE=65536
CODE_MAX_INPUT_SIZE=32768
CODE_MAX_OUTPUT_SIZE=65536
SQL_EXECUTION_URL=http://localhost:3000/api/sql/run

# =============================================================
# APP CONFIGURATION
# =============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EduNexus
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise Learning Management System

# =============================================================
# OPTIONAL: SMTP (for custom email templates)
# =============================================================
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@edunexus.com
