
# ==============================================================================
# SENSILEARN LMS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Duplicate this file as .env.local for local development.
# 2. Duplicate this file as .env.production for production server / Vercel.
# 3. Fill in the real credentials. NEVER commit .env.local or .env.production to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (Required)
# ------------------------------------------------------------------------------
# Where to obtain: Supabase Dashboard -> Project Settings -> API & Data API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-safe publishable anonymous key (legacy JWT or sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# SUPABASE_SERVICE_ROLE_KEY: Privileged server-only secret (NEVER expose to browser!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. APPLICATION CANONICAL CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Production:  https://sensilearn.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SensiLearn LMS
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise Learning Management System & Coding Platform
NEXT_PUBLIC_COMPANY_NAME=SensiLearn Learning Technologies
NEXT_PUBLIC_SUPPORT_EMAIL=support@sensilearn.com

# ------------------------------------------------------------------------------
# 3. RENDER / JOBE CODE COMPILER SERVICE (Required for Dedicated Compiler)
# ------------------------------------------------------------------------------
# Where to obtain: Render Dashboard -> Your Web Service URL
# Local Dev fallback: http://localhost/jobe/index.php/restapi
# Render Production:  https://<your-render-service>.onrender.com/jobe/index.php/restapi
JOBE_URL=http://localhost/jobe/index.php/restapi
JOBE_API_KEY=
JOBE_TIMEOUT=10000
JOBE_DEFAULT_TIME_LIMIT=5
JOBE_DEFAULT_MEMORY_LIMIT=256

# Compiler execution limits
CODE_MAX_SOURCE_SIZE=65536
CODE_MAX_INPUT_SIZE=32768
CODE_MAX_OUTPUT_SIZE=65536
SQL_EXECUTION_URL=/api/sql/run

# ------------------------------------------------------------------------------
# 4. GOOGLE AUTHENTICATION & IDENTITY SERVICES (Recommended)
# ------------------------------------------------------------------------------
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Web Client ID used for client-side Google Identity Services (One Tap & branded prompt):
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 5. WEBRTC LIVE CLASSROOM (Optional — for live sessions)
# ------------------------------------------------------------------------------
# Where to obtain: LiveKit Cloud Dashboard (https://cloud.livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL SERVICE (Optional — for invitation & system emails)
# ------------------------------------------------------------------------------
# Where to obtain: Your SMTP Provider (Google App Password, Resend, SendGrid, Amazon SES)
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@sensilearn.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@sensilearn.com
EMAIL_FROM_NAME=SensiLearn LMS
